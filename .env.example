# Frontend build-time variables. Only VITE_-prefixed variables reach the browser, and everything
# here is PUBLIC (it ends up in the JavaScript bundle). Never put secrets here.

# Base URL of the API server, without a trailing slash (e.g. https://api.example.com).
# Empty = on-device mock mode: no uploads, no accounts, no payments.
VITE_API_BASE_URL=

# Public path the site is served from. CI sets /<repo>/ for GitHub Pages; default /.
# BASE_PATH=/
