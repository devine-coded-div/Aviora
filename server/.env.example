# Copy to .env (never commit it). Everything here stays on the server.

NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres@localhost:5432/avatar_studio
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
# Proxy hops to trust for client IPs (e.g. 1 behind a load balancer)
TRUST_PROXY=0
# Random 32+ char secret for hashing client IPs (required in production)
CLIENT_HASH_SECRET=

# Storage: "s3" (any S3-compatible service, bucket must be private) or "memory" (dev/test only)
STORAGE_DRIVER=memory
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=avatar-studio/

# AI provider. "mock" = labelled filters, not AI. A real provider can only be enabled when
# ALL of the following are set from its contract/terms, and an adapter exists in
# src/providers/registry.ts.
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_PROVIDER_STYLES=
AI_PROVIDER_COST_PER_IMAGE_USD=
AI_PROVIDER_RETENTION_DAYS=
# Must be "false": users are promised their photos are never used for training
AI_PROVIDER_TRAINS_ON_INPUTS=
AI_PROVIDER_TIMEOUT_MS=90000
AI_DAILY_BUDGET_USD=

# Mock provider tuning (testing the UI)
MOCK_DELAY_MS=1500
MOCK_FAIL_RATE=0

# Limits
MAX_UPLOAD_BYTES=8388608
GENERATIONS_PER_HOUR=20
MAX_ACTIVE_JOBS_PER_CLIENT=2
API_REQUESTS_PER_MINUTE=120

# Jobs and retention
JOB_MAX_ATTEMPTS=3
JOB_MAX_MANUAL_RETRIES=2
JOB_RETRY_BASE_MS=2000
JOB_PROCESSING_TIMEOUT_MS=180000
WORKER_CONCURRENCY=2
RESULT_TTL_HOURS=24
FAILED_INPUT_TTL_MINUTES=60

# Credits and payments (Razorpay). Leave all three empty to disable purchases.
# Use rzp_test_ keys (sandbox) in development; live keys need NODE_ENV=production and
# PAYMENTS_ALLOW_LIVE=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ALLOW_LIVE=false
ORDER_EXPIRY_MINUTES=60
ORDERS_PER_HOUR=20
# Free generations per rolling 24 h (per account and per client IP)
FREE_GENERATIONS_PER_DAY=3
ACCOUNTS_PER_HOUR=10
